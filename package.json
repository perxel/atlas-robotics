{
  "name": "tinacms-demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 tinacms build --noTelemetry -c \"next build --webpack\"",
    "dev": "tinacms dev --noTelemetry -c \"next dev\"",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && echo 'uploads/**' > .open-next/assets/.assetsignore && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && echo 'uploads/**' > .open-next/assets/.assetsignore && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && echo 'uploads/**' > .open-next/assets/.assetsignore && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tinacms/cli": "^2.5.6",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tinacms": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.120.0"
  }
}
