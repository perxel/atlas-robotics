# Tina Cloud project credentials (app.tina.io).
# Leave both unset for local dev: the Tina CLI self-hosts content instead
# (see tina/config.ts). Required for any production build/deploy — without
# them the generated Tina client points at a build-time-only localhost
# server that no longer exists once a real visitor hits the site.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Canonical site URL used for SEO (sitemap, canonical/hreflang tags,
# OpenGraph). Required in production; optional in dev.
NEXT_PUBLIC_SITE_URL=
